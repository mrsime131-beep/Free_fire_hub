generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (STATUS, ROLES & CONFIGURATIONS)
// ==========================================

enum UserRole {
  USER
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PAYMENT_REVIEW
  PAYMENT_VERIFIED
  PROCESSING
  DELIVERY_PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  SUBMITTED
  VERIFYING
  VERIFIED
  REJECTED
  REFUNDED
}

enum DeliveryStatus {
  NOT_STARTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRY_PENDING
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  MANUAL
}

enum DeliveryMode {
  DEMO
  LIVE
}

enum NotificationChannel {
  WEBSITE
  TELEGRAM
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ==========================================
// CORE USER & PRODUCT MODELS (EXTENDED)
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String?
  phone        String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("ActorAuditLogs")

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  sku            String   @unique
  category       String   @default("DIAMOND_TOPUP")
  game           String   @default("FREE_FIRE")
  diamondAmount  Int
  bonusDiamonds  Int      @default(0)
  basePrice      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  sellingPrice   Decimal  @db.Decimal(10, 2)
  currency       String   @default("BDT")
  isActive       Boolean  @default(true)
  isPopular      Boolean  @default(false)
  sortOrder      Int      @default(0)
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders           Order[]
  orderItems       OrderItem[]
  supplierProducts SupplierProduct[]

  @@index([isActive, sortOrder])
  @@index([slug])
  @@index([sku])
}

// ==========================================
// ATOMIC ORDER SEQUENCE GENERATOR MODEL
// ==========================================

model DailyOrderSequence {
  dateKey    String   @id // Format: YYYYMMDD (e.g., "20261124")
  currentSeq Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// ==========================================
// SMART ORDER & STATUS HISTORY MODELS
// ==========================================

model Order {
  id                 String         @id @default(uuid())
  orderNumber        String         @unique // Format: FFH-20261124-000001
  userId             String?
  guestId            String?
  customerPhone      String?
  customerEmail      String?
  playerUid          String
  verifiedPlayerName String
  gameServer         String         @default("BD")
  productId          String
  productName        String
  diamondQuantity    Int
  packagePrice       Decimal        @db.Decimal(10, 2)
  discount           Decimal        @default(0.00) @db.Decimal(10, 2)
  finalPayableAmount Decimal        @db.Decimal(10, 2)
  currency           String         @default("BDT")
  paymentMethod      PaymentMethod
  paymentReference   String?
  orderStatus        OrderStatus    @default(PENDING)
  paymentStatus      PaymentStatus  @default(UNPAID)
  deliveryStatus     DeliveryStatus @default(NOT_STARTED)
  idempotencyKey     String?        @unique
  ipAddress          String?
  userAgent          String?
  notes              String?
  cancelReason       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payment             Payment?
  paymentTransactions PaymentTransaction[]
  delivery            Delivery?
  deliveryAttempts    DeliveryAttempt[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([orderNumber])
  @@index([playerUid])
  @@index([userId])
  @@index([guestId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  productName     String
  diamondQuantity Int
  bonusDiamonds   Int      @default(0)
  unitPrice       Decimal  @db.Decimal(10, 2)
  discount        Decimal  @default(0.00) @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(10, 2)
  metadata        Json?
  createdAt       DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id                     String          @id @default(uuid())
  orderId                String
  previousOrderStatus    OrderStatus?
  newOrderStatus         OrderStatus
  previousPaymentStatus  PaymentStatus?
  newPaymentStatus       PaymentStatus
  previousDeliveryStatus DeliveryStatus?
  newDeliveryStatus      DeliveryStatus
  changedBy              String          @default("SYSTEM")
  reason                 String?
  metadata               Json?
  createdAt              DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ==========================================
// SMART PAYMENT & TRANSACTION MODELS
// ==========================================

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @unique
  method               PaymentMethod
  status               PaymentStatus @default(UNPAID)
  expectedAmount       Decimal       @db.Decimal(10, 2)
  paidAmount           Decimal       @default(0.00) @db.Decimal(10, 2)
  currency             String        @default("BDT")
  senderNumber         String?
  transactionReference String?       @unique
  proofUrl             String?
  submittedAt          DateTime?
  verifiedBy           String?
  verifiedAt           DateTime?
  rejectionReason      String?
  refundStatus         String?       @default("NONE")
  refundedAt           DateTime?
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([transactionReference])
  @@index([status])
  @@index([method])
}

model PaymentTransaction {
  id                   String        @id @default(uuid())
  paymentId            String
  orderId              String
  method               PaymentMethod
  transactionReference String        @unique
  senderNumber         String?
  amount               Decimal       @db.Decimal(10, 2)
  status               PaymentStatus @default(SUBMITTED)
  rawPayload           Json?
  reviewedBy           String?
  reviewNotes          String?
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([transactionReference])
  @@index([orderId])
  @@index([paymentId])
}

// ==========================================
// AUTOMATIC DELIVERY & SUPPLIER MODELS
// ==========================================

model Supplier {
  id              String       @id @default(uuid())
  code            String       @unique // e.g., "DEMO_SUPPLIER", "OFFICIAL_GARENA_PARTNER"
  name            String
  adapterType     DeliveryMode @default(DEMO)
  apiEndpoint     String?
  apiKeyEnvVar    String?      // Name of ENV variable holding secret key
  apiSecretEnvVar String?
  timeoutMs       Int          @default(15000)
  isActive        Boolean      @default(true)
  priority        Int          @default(1)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  supplierProducts SupplierProduct[]
  deliveries       Delivery[]
  deliveryAttempts DeliveryAttempt[]

  @@index([code])
  @@index([isActive, priority])
}

model SupplierProduct {
  id                  String   @id @default(uuid())
  supplierId          String
  productId           String
  externalProductCode String
  costPrice           Decimal  @db.Decimal(10, 2)
  isActive            Boolean  @default(true)
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

model Delivery {
  id                String         @id @default(uuid())
  orderId           String         @unique
  supplierId        String?
  status            DeliveryStatus @default(NOT_STARTED)
  deliveryMode      DeliveryMode   @default(DEMO)
  deliveryReference String?        @unique
  externalOrderId   String?
  attemptCount      Int            @default(0)
  maxRetries        Int            @default(3)
  nextRetryAt       DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?
  lockedAt          DateTime?
  lockedBy          String?
  completedAt       DateTime?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  attempts DeliveryAttempt[]

  @@index([status, nextRetryAt])
  @@index([orderId])
  @@index([deliveryReference])
}

model DeliveryAttempt {
  id              String         @id @default(uuid())
  deliveryId      String
  orderId         String
  supplierId      String?
  attemptNumber   Int
  deliveryMode    DeliveryMode   @default(DEMO)
  idempotencyKey  String         @unique
  requestPayload  Json?
  responsePayload Json?
  httpStatus      Int?
  status          DeliveryStatus
  deliveryRef     String?
  errorCode       String?
  errorMessage    String?
  durationMs      Int?
  triggeredBy     String         @default("SYSTEM")
  createdAt       DateTime       @default(now())

  delivery Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([deliveryId, attemptNumber])
  @@index([orderId])
}

// ==========================================
// NOTIFICATION, AUDIT & IDEMPOTENCY MODELS
// ==========================================

model Notification {
  id           String              @id @default(uuid())
  orderId      String?
  userId       String?
  channel      NotificationChannel
  eventType    String
  recipient    String?
  title        String
  message      String
  status       NotificationStatus  @default(PENDING)
  errorMessage String?
  metadata     Json?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
  @@index([status, channel])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorEmail    String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String
  orderId       String?
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User?  @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([actorId])
  @@index([action, createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  key            String   @unique
  endpoint       String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  orderId        String?
  isLocked       Boolean  @default(true)
  lockedUntil    DateTime
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
  @@index([expiresAt])
}
