# ============================================================================
# FREE FIRE HUB BD — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# যেকোনো আসল Secret বা Database Password কখনোই GitHub-এ Commit করবেন না।
# Render Dashboard -> Environment সেকশনে আসল মানগুলো সেট করবেন।
# ============================================================================

# ১. সার্ভার কনফিগারেশন
NODE_ENV=development
PORT=5000

# ২. PostgreSQL ডাটাবেস কানেকশন (Render PostgreSQL Internal/External URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/free_fire_hub_db?schema=public"

# ৩. ফ্রন্টএন্ড ও CORS সিকিউরিটি (আপনার লাইভ ফ্রন্টএন্ড ও লোকালহোস্ট)
FRONTEND_URL="https://free-fire-hub-12.onrender.com"
ALLOWED_ORIGINS="https://free-fire-hub-12.onrender.com,http://localhost:3000"

# ৪. JWT অথেনটিকেশন সিকিউরিটি (Production-এ অবশ্যই কমপক্ষে ৩২ ক্যারেক্টারের শক্তিশালী কী দিবেন)
JWT_SECRET="replace_with_a_strong_random_64_character_secret_key_in_render"
JWT_EXPIRES_IN="7d"

# ৫. Player UID Lookup API কনফিগারেশন
PLAYER_LOOKUP_API_URL="https://auraffxserverinfocheckerapi.onrender.com/api/player"
PLAYER_LOOKUP_TIMEOUT_MS=10000

# ৬. ম্যানুয়াল পেমেন্ট মার্চেন্ট/পার্সোনাল নম্বরসমূহ (ডাটাবেস সিড ও API-এর জন্য)
BKASH_MERCHANT_NUMBER="01700000000"
NAGAD_MERCHANT_NUMBER="01800000000"
ROCKET_MERCHANT_NUMBER="01900000000"

# ৭. অটোমেটিক ডায়মন্ড ডেলিভারি ইঞ্জিন মোড
# অনুমোদিত সাপ্লায়ার API না থাকা পর্যন্ত এটি "DEMO" থাকবে। অফিশিয়াল API পেলে "LIVE" করা হবে।
DELIVERY_MODE="DEMO"
SUPPLIER_API_BASE_URL=""
SUPPLIER_API_KEY=""
SUPPLIER_API_SECRET=""

# ৮. প্রাথমিক অ্যাডমিন অ্যাকাউন্ট (Prisma Seed চালানোর সময় তৈরি হবে, পরে পরিবর্তনযোগ্য)
ADMIN_DEFAULT_EMAIL="admin@freefirehub.bd"
ADMIN_DEFAULT_PASSWORD="ChangeThisAdminPassword123!"
