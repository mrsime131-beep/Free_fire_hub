# ============================================================================
# ১. সার্ভার ও অ্যাপ্লিকেশন কনফিগারেশন (Server & App Config)
# ============================================================================
NODE_ENV=production
PORT=5000
SERVICE_NAME=free-fire-hub-backend
APP_VERSION=2.0.0

# আপনার ফ্রন্টএন্ডের লাইভ URL (Vercel / Render) এবং লোকালহোস্ট
FRONTEND_URL=https://free-fire-hub.onrender.com
CORS_ORIGINS=https://free-fire-hub.onrender.com,http://localhost:3000

# ============================================================================
# ২. ডাটাবেস কনফিগারেশন (Neon Serverless PostgreSQL)
# ============================================================================
# আপনার আসল Neon PostgreSQL Connection String এখানে বসান (কখনই গিটহাবে আসল .env পুশ করবেন না)
DATABASE_URL="postgresql://neondb_owner:YOUR_DB_PASSWORD@ep-your-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================================
# ৩. অথেনটিকেশন ও অ্যাডমিন সিকিউরিটি (JWT & Default Admin Seed)
# ============================================================================
JWT_SECRET="replace_with_a_very_strong_random_64_character_hex_secret_key"
JWT_EXPIRES_IN=7d

# ডাটাবেস সিড (npm run db:seed) করার সময় এই ইমেইল ও পাসওয়ার্ড দিয়ে ডিফল্ট অ্যাডমিন তৈরি হবে
ADMIN_EMAIL=admin@freefirehub.com
ADMIN_PASSWORD="ChangeThisAdminPassword123!"

# ============================================================================
# ৪. অটোমেটিক ডেলিভারি ইঞ্জিন ও রিট্রাই কনফিগারেশন (Delivery & Retry Engine)
# ============================================================================
# DELIVERY_MODE হতে পারে "DEMO" অথবা "LIVE"
# DEMO মোডে বাস্তব ডায়মন্ড না পাঠিয়ে নিরাপদ সিমুলেশন রেফারেন্স (DEMO-FFH-...) তৈরি করবে
DELIVERY_MODE=DEMO

# ডেলিভারি ব্যর্থ হলে স্বয়ংক্রিয়ভাবে সর্বোচ্চ কতবার চেষ্টা (Retry) করবে
MAX_DELIVERY_RETRIES=3

# প্রথম রিট্রাইয়ের বেস বিরতি (মিলিসেকেন্ডে: 30000 = ৩০ সেকেন্ড)
RETRY_BASE_DELAY_MS=30000

# সাপ্লায়ার API রেসপন্স টাইমআউট (মিলিসেকেন্ডে: 15000 = ১৫ সেকেন্ড)
SUPPLIER_TIMEOUT_MS=15000

# ============================================================================
# ৫. লাইভ সাপ্লায়ার API ক্রেডেনশিয়ালস (শুধুমাত্র DELIVERY_MODE=LIVE হলে আবশ্যক)
# ============================================================================
SUPPLIER_API_URL=""
SUPPLIER_API_KEY=""
SUPPLIER_API_SECRET=""

# ============================================================================
# ৬. ম্যানুয়াল পেমেন্ট ও কাস্টমার সাপোর্ট নাম্বার (bKash / Nagad / Rocket)
# ============================================================================
BKASH_NUMBER=01623759878
NAGAD_NUMBER=01623759878
ROCKET_NUMBER=01623759878
SUPPORT_WHATSAPP=01623759878

# ============================================================================
# ৭. ঐচ্ছিক টেলিগ্রাম ও ওয়েবহুক নোটিফিকেশন (Optional Admin Alerts)
# ============================================================================
TELEGRAM_BOT_TOKEN="9076453619:AAE0YXjXadnixo958vKMBRsfsId4rVk66C4"
TELEGRAM_ADMIN_CHAT_ID="7681573669"
WEBHOOK_NOTIFICATION_URL=""
